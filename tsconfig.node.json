{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node"],
    "isolatedModules": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/web/**/*", "node_modules", "dist"]
}
